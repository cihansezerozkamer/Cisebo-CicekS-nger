---
// Olmayan adreslerde GitHub Pages bu sayfayı (404.html) 404 durum koduyla gösterir.
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Icon from '../components/Icon.astro';
import { waLink } from '../data/site';
import { useLang } from '../i18n';
const { ui, href } = useLang(Astro.url);
---

<Base title={ui.bulunamadiBaslik} noindex>
  <section class="page-head wrap nf">
    <p class="nf__code" aria-hidden="true">404</p>
    <h1>{ui.bulunamadiBaslik}</h1>
    <p class="lead">{ui.bulunamadiMetin}</p>
    <div class="nf__cta">
      <a class="sponge" href={href()}>{ui.anaSayfa}</a>
      <a class="sponge sponge--light" href={waLink(ui.wa.bilgi)}>
        <Icon name="whatsapp" />
        WhatsApp
      </a>
    </div>
  </section>
  <section class="wrap" style="padding-bottom: clamp(3.5rem, 8vw, 6rem)">
    <ProductGrid />
  </section>
</Base>

<style>
  .nf__code {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 700;
    line-height: 1;
    color: var(--sunger-koyu);
    margin: 0 0 0.5rem;
  }
  .nf__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
