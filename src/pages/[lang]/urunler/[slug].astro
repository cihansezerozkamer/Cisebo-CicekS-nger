---
import View from '../../../views/Product.astro';
import { products } from '../../../data/products';
import { otherLangs } from '../../../i18n';

export function getStaticPaths() {
  return otherLangs.flatMap((lang) => products.map((p) => ({ params: { lang, slug: p.slug } })));
}
---

<View slug={Astro.params.slug} />
