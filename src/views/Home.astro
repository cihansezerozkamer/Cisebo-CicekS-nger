---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import FillGuide from '../components/FillGuide.astro';
import Calculator from '../components/Calculator.astro';
import WhyUs from '../components/WhyUs.astro';
import Shipping from '../components/Shipping.astro';
import VideoStrip from '../components/VideoStrip.astro';
import WholesaleBand from '../components/WholesaleBand.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { site } from '../data/site';
import { useLang, y } from '../i18n';
const { m: all, href } = useLang(Astro.url);
const m = all.anaSayfa;
---

<Base title={site.name} home>
  <Hero />

  <section class="section" aria-labelledby="urunler-baslik">
    <div class="wrap">
      <div class="head">
        <h2 id="urunler-baslik">{y(m.urunlerBasligi)}</h2>
        <a href={href('urunler')}>{m.tumUrunlerLinki}</a>
      </div>
      <ProductGrid />
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap stack">
      <FillGuide />
      <Calculator />
    </div>
  </section>

  <section class="section" aria-labelledby="neden-baslik">
    <div class="wrap stack">
      <div>
        <h2 id="neden-baslik">{y(m.nedenBasligi)}</h2>
        <WhyUs />
      </div>
      <Shipping />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="video-baslik">
    <div class="wrap">
      <h2 id="video-baslik">{m.videoBasligi}</h2>
      <p class="muted">{m.videoAciklamasi}</p>
      <VideoStrip />
    </div>
  </section>

  <WholesaleBand />

  <section class="section section--contact">
    <div class="wrap">
      <ContactBlock />
    </div>
  </section>
</Base>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .head h2 {
    margin: 0;
    max-width: 20ch;
  }
  .head a {
    font-weight: 700;
  }
  .section--soft {
    background: var(--pembe-acik);
    border-radius: clamp(2rem, 5vw, 4rem);
  }
  .stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 5rem);
  }
  .section--tight {
    padding-top: 0;
  }
  .section--contact {
    background: var(--bordo);
  }
  .section--contact :global(.contact) {
    background: var(--pembe);
    border-radius: var(--r-pillow);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
