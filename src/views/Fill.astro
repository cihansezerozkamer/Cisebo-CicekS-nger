---
import Base from '../layouts/Base.astro';
import FillGuide from '../components/FillGuide.astro';
import Calculator from '../components/Calculator.astro';
import { useLang } from '../i18n';
const { m: all, ui, href } = useLang(Astro.url);
const m = all.hangiDolguSayfasi;
const crumb = ui.menu.find((x) => x.path === 'hangi-dolgu')?.label ?? m.baslik;
---

<Base title={m.googleBasligi} description={m.googleAciklamasi}>
  <section class="page-head wrap">
    <nav class="crumbs" aria-label={ui.anaSayfa}>
      <ol>
        <li><a href={href()}>{ui.anaSayfa}</a></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <h1>{m.baslik}</h1>
    <p class="lead">{m.aciklama}</p>
  </section>

  <div class="wrap body">
    <FillGuide />
    <Calculator />

    <section>
      <h2>{m.tabloBasligi}</h2>
      <div class="tbl" tabindex="0" role="region" aria-label={m.tabloBasligi}>
        <table>
          <thead>
            <tr>{m.tabloBasliklari.map((t) => <th scope="col">{t}</th>)}</tr>
          </thead>
          <tbody>
            {
              m.tablo.map((c) => (
                <tr>
                  <th scope="row"><a href={href(`urunler/${c.urun}`)}>{c.dolgu}</a></th>
                  <td>{c.his}</td>
                  <td>{c.yer}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  .tbl {
    overflow-x: auto;
    border-radius: var(--r-pillow);
    background: var(--pembe-acik);
    box-shadow: var(--shadow-pillow);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 34rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.95rem 1.25rem;
    border-bottom: 1.5px solid var(--pembe-koyu);
  }
  thead th {
    color: var(--ink-soft);
    font-size: var(--t-sm);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody th a {
    font-weight: 700;
  }
</style>
