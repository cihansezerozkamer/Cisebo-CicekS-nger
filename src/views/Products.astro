---
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { useLang } from '../i18n';
const { m: all, ui, href } = useLang(Astro.url);
const m = all.urunlerSayfasi;
---

<Base title={m.baslik} description={m.googleAciklamasi}>
  <section class="page-head wrap">
    <nav class="crumbs" aria-label={ui.anaSayfa}>
      <ol>
        <li><a href={href()}>{ui.anaSayfa}</a></li>
        <li aria-current="page">{m.baslik}</li>
      </ol>
    </nav>
    <h1>{m.baslik}</h1>
    <p class="lead">{m.aciklama}</p>
  </section>
  <section class="wrap" style="padding-bottom: clamp(3.5rem, 8vw, 6rem)">
    <ProductGrid />
  </section>
</Base>
