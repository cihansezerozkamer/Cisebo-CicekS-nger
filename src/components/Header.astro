---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { waLink } from '../data/site';
import { useLang } from '../i18n';

const { ui, href } = useLang(Astro.url);
const current = Astro.url.pathname;
---

<header class="hdr">
  <div class="wrap hdr__in">
    <Logo />
    <nav class="hdr__nav" id="site-nav" aria-label={ui.menuButonu}>
      <ul>
        {
          ui.menu.map((item) => {
            const url = href(item.path);
            return (
              <li>
                <a href={url} aria-current={current.startsWith(url) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="hdr__tools">
      <LangSwitch />
      <a class="sponge sponge--sm hdr__wa" href={waLink(ui.wa.bilgi)} aria-label="WhatsApp">
        <Icon name="whatsapp" />
        <span>WhatsApp</span>
      </a>
      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr">{ui.menuButonu}</span>
        <span class="hdr__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hdr__toggle');
  const navEl = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--pembe) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 5.5rem;
  }
  .hdr__nav {
    margin-left: auto;
  }
  .hdr__nav ul {
    display: flex;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hdr__nav a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--r-pill);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .hdr__nav a:hover {
    background: var(--pembe-acik);
  }
  .hdr__nav a[aria-current='page'] {
    color: var(--bordo);
    background: var(--pembe-acik);
  }
  .hdr__tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hdr__toggle {
    display: none;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* menü kalabalıklaşınca WhatsApp yazısı gizlenir, ikon kalır */
  @media (max-width: 82rem) {
    .hdr__wa span {
      display: none;
    }
    .hdr__wa {
      padding-inline: 0.8rem;
    }
  }

  @media (max-width: 71.99rem) {
    .hdr__nav {
      position: absolute;
      inset: 100% 0 auto;
      margin: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--pembe);
      box-shadow: 0 20px 30px -24px rgba(79, 16, 34, 0.5);
      display: none;
    }
    .hdr__nav.is-open {
      display: block;
    }
    .hdr__nav ul {
      flex-direction: column;
    }
    .hdr__nav a {
      padding: 0.8rem 0.9rem;
      font-size: 1.05rem;
    }
    .hdr__tools {
      margin-left: auto;
    }
    .hdr__toggle {
      display: grid;
      place-items: center;
      width: 2.9rem;
      height: 2.9rem;
      border: 0;
      border-radius: 1rem;
      background: var(--pembe-acik);
      cursor: pointer;
    }
    .hdr__bars,
    .hdr__bars::before,
    .hdr__bars::after {
      display: block;
      width: 1.2rem;
      height: 2px;
      border-radius: 2px;
      background: var(--bordo);
      position: relative;
      transition: transform 0.2s;
    }
    .hdr__bars::before,
    .hdr__bars::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .hdr__bars::before {
      top: -6px;
    }
    .hdr__bars::after {
      top: 6px;
    }
    .hdr__toggle[aria-expanded='true'] .hdr__bars {
      background: transparent;
    }
    .hdr__toggle[aria-expanded='true'] .hdr__bars::before {
      transform: translateY(6px) rotate(45deg);
    }
    .hdr__toggle[aria-expanded='true'] .hdr__bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
  @media (max-width: 34rem) {
    .hdr__in {
      gap: 0.5rem;
    }
    .hdr__wa {
      display: none;
    }
    .hdr__tools :global(.ls span) {
      display: none;
    }
    .hdr__tools :global(.ls a) {
      padding: 0.4rem;
    }
  }
  @media (max-width: 22.5rem) {
    .hdr :global(.logo__word) {
      display: none;
    }
  }
</style>
