---
// Logo çizimi (yalnızca SVG): kurucumuzun yüz çizimi (annem.png'den kırpılmış logo-yuz.png),
// saçında süngerden çiçekler. Çizgiler SVG filtresiyle bordoya boyanır.
// Header'daki Logo ve açılış ekranı (Splash) bunu kullanır.
import { getImage } from 'astro:assets';
import yuz from '../assets/img/logo-yuz.png';

interface Props {
  class?: string;
}
const { class: cls = 'logo__mark' } = Astro.props;
const img = await getImage({ src: yuz, width: 480, height: 480, format: 'webp' });
const uid = `lg${Math.random().toString(36).slice(2, 7)}`;

// saçtaki sünger çiçekler (480×480 çizim alanında)
const flowers = [
  { x: 128, y: 104, s: 1.5 },
  { x: 222, y: 66, s: 1.2 },
  { x: 326, y: 100, s: 1.3 },
  { x: 80, y: 206, s: 1.1 },
];
const petals = [0, 72, 144, 216, 288].map((d) => {
  const r = (d * Math.PI) / 180;
  return { x: +(Math.sin(r) * 14).toFixed(1), y: +(-Math.cos(r) * 14).toFixed(1), px: +(Math.sin(r) * 17).toFixed(1), py: +(-Math.cos(r) * 17).toFixed(1) };
});
---

<svg class={cls} viewBox="0 0 480 480" aria-hidden="true">
  <defs>
    <!-- siyah çizgi → bordo, beyaz → şeffaf -->
    <filter id={`${uid}-f`} color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="0 0 0 0 0.35  0 0 0 0 0.07  0 0 0 0 0.15  -0.39 -0.77 -0.14 0 1.3"></feColorMatrix>
    </filter>
    <radialGradient id={`${uid}-b`}>
      <stop offset="0" stop-color="#f08a96" stop-opacity=".55"></stop>
      <stop offset="1" stop-color="#f08a96" stop-opacity="0"></stop>
    </radialGradient>
    <clipPath id={`${uid}-c`}>
      <circle cx="240" cy="240" r="226"></circle>
    </clipPath>
  </defs>

  <circle cx="240" cy="240" r="226" fill="#fcefee"></circle>
  <g clip-path={`url(#${uid}-c)`}>
    <image href={img.src} width="480" height="480" filter={`url(#${uid}-f)`}></image>
    <g class="logo__blush" fill={`url(#${uid}-b)`}>
      <ellipse cx="185" cy="262" rx="30" ry="18"></ellipse>
      <ellipse cx="300" cy="252" rx="20" ry="14"></ellipse>
    </g>
    {
      flowers.map((f) => (
        <g transform={`translate(${f.x} ${f.y}) scale(${f.s})`}>
          <g class="logo__flower">
            {petals.map((p) => (
              <circle cx={p.x} cy={p.y} r="11.5" fill="#f2d688" stroke="#5a1226" stroke-width="3.2" />
            ))}
            {petals.map((p) => (
              <circle cx={p.px * 0.95} cy={p.py * 0.95} r="1.6" fill="#a87b1c" opacity=".4" />
            ))}
            <circle r="6.5" fill="#5a1226" />
          </g>
        </g>
      ))
    }
  </g>
  <circle cx="240" cy="240" r="226" fill="none" stroke="#7a1c33" stroke-width="12"></circle>
</svg>
