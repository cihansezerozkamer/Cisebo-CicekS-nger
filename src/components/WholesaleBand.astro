---
import Icon from './Icon.astro';
import { telLink, waLink, site } from '../data/site';
import { useLang, y } from '../i18n';
const { m: all, ui, href } = useLang(Astro.url);
const m = all.toptanBandi;
---

<section class="band">
  <div class="wrap band__in">
    <div>
      <h2>{y(m.baslik)}</h2>
      <p>{y(m.aciklama)}</p>
      <a class="band__more" href={href('toptan')}>{m.link}</a>
    </div>
    <div class="band__cta">
      <a class="sponge sponge--light" href={telLink()}>
        <Icon name="phone" />
        {site.phoneDisplay}
      </a>
      <a class="sponge sponge--mint" href={waLink(ui.wa.toptan)}>
        <Icon name="whatsapp" />
        {m.whatsappButonu}
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--bordo);
    color: var(--pembe);
    padding-block: clamp(3rem, 7vw, 5rem);
    border-radius: clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem) 0 0;
  }
  .band__in {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .band h2 {
    color: var(--pembe-acik);
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    max-width: 16ch;
  }
  .band p {
    color: var(--pembe-koyu);
  }
  .band__more {
    color: var(--sari);
    font-weight: 700;
  }
  .band__cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }
  @media (max-width: 47.99rem) {
    .band__in {
      grid-template-columns: 1fr;
    }
  }
</style>
