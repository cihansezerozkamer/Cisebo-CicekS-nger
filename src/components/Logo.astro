---
// Logo: çizim + yazı. Fare üzerine gelince çiçekler hafifçe döner, yanaklar hafifçe pembeleşir.
import LogoMark from './LogoMark.astro';
import { site } from '../data/site';
import { useLang } from '../i18n';
const { href, ui } = useLang(Astro.url);
---

<a class="logo" href={href()} aria-label={`${site.name}, ${ui.anaSayfa}`}>
  <LogoMark />
  <span class="logo__word">Çiçek Sünger</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--bordo);
  }
  :global(.logo__mark) {
    width: 4.4rem;
    height: 4.4rem;
    flex: none;
  }
  :global(.logo__flower) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.9s cubic-bezier(0.3, 1.2, 0.5, 1);
  }
  :global(.logo__blush) {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .logo:hover :global(.logo__flower),
  .logo:focus-visible :global(.logo__flower) {
    transform: rotate(72deg);
  }
  .logo:hover :global(.logo__blush),
  .logo:focus-visible :global(.logo__blush) {
    opacity: 1;
  }

  .logo__word {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  @media (max-width: 30rem) {
    :global(.logo__mark) {
      width: 3.6rem;
      height: 3.6rem;
    }
    .logo__word {
      font-size: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.logo__flower),
    :global(.logo__blush) {
      transition: none;
    }
  }
</style>
