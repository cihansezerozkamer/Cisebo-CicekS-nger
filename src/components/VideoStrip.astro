---
// Depodan videolar: yatay kaydırmalı şerit, sağ/sol butonlarıyla.
// Videolar tıklanınca oynar (sayfa yükünü azaltmak için).
import { useLang } from '../i18n';
const { m, ui } = useLang(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const videos = m.videolar.map((v) => ({ file: v.dosya, caption: v.yazi }));
---

<div class="vs" data-vstrip>
  <div class="vs__nav">
    <button type="button" class="sponge sponge--sm vs__btn" data-dir="-1" aria-label={ui.oncekiVideolar}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button type="button" class="sponge sponge--sm vs__btn" data-dir="1" aria-label={ui.sonrakiVideolar}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>

  <div class="vs__track" tabindex="0" aria-label={ui.videoSeridi}>
    {
      videos.map((v) => (
        <figure>
          <video controls muted playsinline preload="none" poster={`${base}/video/poster/${v.file}.jpg`}>
            <source src={`${base}/video/${v.file}.mp4`} type="video/mp4" />
          </video>
          <figcaption>{v.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-vstrip]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.vs__track')!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.vs__btn');
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
      root.classList.toggle('is-static', max <= 0);
    };
    root.querySelectorAll<HTMLButtonElement>('.vs__btn').forEach((b) =>
      b.addEventListener('click', () => {
        const step = track.clientWidth * 0.8 * Number(b.dataset.dir);
        track.scrollBy({ left: step, behavior: 'smooth' });
      }),
    );
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .vs {
    position: relative;
  }
  .vs__nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
  }
  .vs.is-static .vs__nav {
    visibility: hidden;
  }
  .vs__btn {
    width: 3rem;
    padding: 0;
  }
  .vs__btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .vs__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(11rem, 42vw, 15rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 0 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--bordo) transparent;
  }
  .vs__track figure {
    margin: 0;
    scroll-snap-align: start;
  }
  .vs__track video {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: 1.6rem;
    background: var(--pembe-koyu);
    box-shadow: var(--shadow-pillow);
  }
  .vs__track figcaption {
    margin-top: 0.6rem;
    font-weight: 600;
    font-size: var(--t-sm);
  }
</style>
